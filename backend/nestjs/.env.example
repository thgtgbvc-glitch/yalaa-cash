NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://yalla_cash:yalla_cash@localhost:5432/yalla_cash?schema=public

# Comma-separated Flutter/Web origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-character-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
QR_TOKEN_SECRET=replace-with-a-32-random-character-qr-secret
QR_TOKEN_TTL_SECONDS=120
SECRET_PEPPER=replace-with-a-server-side-hmac-pepper

# Development-only OTP. Set OTP_DEV_MODE=false in production and connect a real SMS provider.
OTP_DEV_MODE=true
OTP_TTL_SECONDS=300
OTP_LENGTH=6

# LinkSyria delivers the OTP SMS (generation/verification stay in this app).
# Required when OTP_DEV_MODE=false. Never expose LINKSYRIA_API_KEY to clients.
LINKSYRIA_API_URL=https://linksyria.online
LINKSYRIA_API_KEY=

# Firebase Admin is used to verify Google/Facebook OAuth identity tokens from Flutter.
# For local development, omit these and the OAuth endpoint will return 503 until configured.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional seed credentials for local development.
SEED_ADMIN_EMAIL=admin@yallacash.app
SEED_ADMIN_PASSWORD=admin123
SEED_MERCHANT_EMAIL=wasim@yallacash.app
SEED_MERCHANT_PASSWORD=123456
